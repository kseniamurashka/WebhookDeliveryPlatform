# Настройки для локального запуска приложения вне Docker.
DATABASE_URL=postgresql+asyncpg://webhook_user:webhook_password@localhost:5432/webhooks
REDIS_URL=redis://localhost:6379/0
API_KEY=demo-api-key
TEST_WEBHOOK_SECRET=whsec_demo_secret

# Используются сервисом PostgreSQL в Docker Compose.
POSTGRES_DB=webhooks
POSTGRES_USER=webhook_user
POSTGRES_PASSWORD=webhook_password
